/* Catppuccin Mocha Colors */
@define-color base   #1e1e2e;
@define-color mantle #181825;
@define-color text   #cdd6f4;
@define-color mauve  #cba6f7;
@define-color lavender #b4befe;
@define-color surface0 #313244;

window {
    margin: 0px;
    border: 3px solid @lavender;
    background-color: @base;
    border-radius: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
}

#input {
    margin: 10px;
    border: none;
    color: @text;
    background-color: @surface0;
    border-radius: 8px;
    padding: 10px;
}

#inner-box {
    margin: 10px;
    border: none;
    background-color: @base;
}

#outer-box {
    margin: 0px;
    border: none;
    background-color: @base;
}

#scroll {
    margin: 5px;
    border: none;
}

#text {
    margin: 5px;
    border: none;
    color: @text;
}

#entry:selected {
    background-color: @surface0;
    border-radius: 8px;
    outline: none;
}

#text:selected {
    color: @mauve;
    font-weight: bold;
}
